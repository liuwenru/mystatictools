#compdef rg
local prev=${(Q)words[CURRENT-1]}
local -a w
case $prev in
    --color) w=(always auto never ansi) ;;
    --engine) w=(default pcre2 auto) ;;
    -t|--type|-T|--type-not) w=(${${(f)"$(rg --type-list 2>/dev/null)"}%%:*}) ;;
    -e|--regexp|-g|--glob|--iglob|-r|--replace|-m|--max-count|-A|--after-context|-B|--before-context|-C|--context|-j|--threads|--max-depth|--max-filesize|--encoding|--sort|--sortr|--type-add|--type-clear)
        return 1 ;;
    -f|--file|--ignore-file) ;;
    *)
        [[ $PREFIX == -* ]] && w=(-e -f -i -s -S -v -w -x -F -P -U -z -a -n -N -H -I -l -L -c -o
            -q -r -g -t -T -A -B -C -m -j --hidden --no-ignore --no-ignore-vcs --follow --files
            --type-list --type-add --type-clear --glob --iglob --ignore-file --max-depth
            --max-filesize --color --engine --encoding --sort --sortr --stats --json --trim
            --heading --no-heading --line-buffered --help --version) ;;
esac
if (( $#w )); then
    compadd -a w
else
    _files
fi
